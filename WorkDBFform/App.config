<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <appSettings>
        <!--
            Конфиг необязателен: папку и базу проще указать при запуске,
                WorkDBFform.exe D:\NAS "ГНИ \"Слободзея\"" localhost
            Здесь — значения на случай запуска БЕЗ параметров: если Folder и Database заполнены,
            загрузка идёт без окна; если пустые — открывается окно.
        -->
        <!-- папка с DBF (вложенные папки тоже); несколько папок или файлов — через ; -->
        <add key="Folder" value="" />
        <!-- база данных так, как она показана в SSMS (кавычки внутри записываются как &quot;) -->
        <add key="Database" value="" />
        <!-- сервер, например: localhost  или  .\SQLEXPRESS -->
        <add key="Server" value="localhost" />
        <!-- false — таблицы, которые уже есть в базе, пропускаются (по умолчанию);
             true — заменять их свежими данными (как параметр /replace) -->
        <add key="Replace" value="false" />
        <!-- действует при Replace=true: true — не заменять таблицы, чей DBF не менялся с прошлой загрузки;
             false — заменять все (как параметр /all) -->
        <add key="SkipUnchanged" value="true" />
        <!-- true — после загрузки без окна показать сообщение с итогом (само закроется через 30 минут);
             false — не показывать (как параметр /quiet) -->
        <add key="ShowResult" value="true" />
    </appSettings>
</configuration>
